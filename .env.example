# ==============================================================================
# Mitmachim Draft Sync — Server environment
# Copy this file to `server/.env` (or project-root `.env`) and fill real values.
# NEVER commit the real .env file. See docs/SECURITY.md.
# ==============================================================================

# Port the API listens on (Nginx reverse-proxies to this).
PORT=3001

# Bind host. Use 127.0.0.1 in production behind Nginx so the API is not
# reachable directly from the internet.
HOST=127.0.0.1

# node env: development | production
NODE_ENV=production

# Absolute or relative path to the SQLite database file.
DB_PATH=./data/draftsync.db

# ------------------------------------------------------------------------------
# SECRETS — generate strong random values. Example generators:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ------------------------------------------------------------------------------

# Server-side pepper mixed into the HMAC used to hash Sync Keys and tokens.
# If this leaks or changes, existing Sync Keys/tokens can no longer be matched,
# so treat it as a long-lived secret and back it up securely.
SYNC_KEY_PEPPER=change-me-to-a-long-random-string

# How long an access token stays valid, in days.
TOKEN_TTL_DAYS=365

# ------------------------------------------------------------------------------
# CORS — comma-separated list of extra web origins allowed to call the API.
# chrome-extension:// origins are always reflected automatically (the extension
# uses a random extension id), so you usually do not need to add anything here.
# Leave empty unless you also call the API from a normal website.
# ------------------------------------------------------------------------------
CORS_EXTRA_ORIGINS=

# ------------------------------------------------------------------------------
# Rate limiting (simple in-memory limiter).
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=120
RATE_LIMIT_MAX_PER_USER=300

# Which proxy hops to trust for the real client IP (used by per-IP rate limit).
# 'loopback' trusts only 127.0.0.1/::1 (Nginx on the same host) — recommended.
# Other values: 'false' (no proxy), a hop count like '1', or a specific CIDR.
TRUST_PROXY=loopback

# Max request body size in bytes (default ~1.5MB to comfortably fit a 100KB
# encrypted draft plus base64 overhead and metadata).
MAX_BODY_BYTES=1572864

# Soft-deleted drafts older than this many days are purged by the cleanup job.
PURGE_DELETED_AFTER_DAYS=30

# Log level: debug | info | warn | error
LOG_LEVEL=info
